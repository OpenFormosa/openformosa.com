---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {% assign pages = site.pages | where_exp: "page", "page.layout" | where_exp: "page", "page.url != '/sitemap.xml'" | where_exp: "page", "page.url != '/feed.xml'" | where_exp: "page", "page.url != '/robots.txt'" | where_exp: "page", "page.url != '/404/'" | where_exp: "page", "page.url != '/404.html'" %}
  {% for page in pages %}
    {% unless page.url contains '/assets/' or page.url contains '/404' or page.url contains '.txt' %}
      {% assign priority = "0.8" %}
      {% assign freq = "monthly" %}
      {% if page.url == "/" %}
        {% assign priority = "1.0" %}
        {% assign freq = "weekly" %}
      {% elsif page.url == "/models/" or page.url == "/blog/" or page.url == "/roadmap/" %}
        {% assign priority = "0.9" %}
        {% assign freq = "weekly" %}
      {% elsif page.url contains "/forms/" %}
        {% assign priority = "0.6" %}
      {% endif %}
  <url>
    <loc>{{ page.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ page.last_modified_at | default: site.time | date_to_xmlschema }}</lastmod>
    <changefreq>{{ freq }}</changefreq>
    <priority>{{ priority }}</priority>
    <image:image>
      <image:loc>{{ page.og_image | default: '/assets/img/openformosa-og.png' | absolute_url | xml_escape }}</image:loc>
      <image:title>{{ page.zh_title | default: page.title | default: site.title | xml_escape }}</image:title>
    </image:image>
  </url>
    {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
    <image:image>
      <image:loc>{{ post.og_image | default: '/assets/img/openformosa-og.png' | absolute_url | xml_escape }}</image:loc>
      <image:title>{{ post.zh_title | default: post.title | xml_escape }}</image:title>
    </image:image>
  </url>
  {% endfor %}
</urlset>

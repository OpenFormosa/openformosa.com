---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="zh-Hant">
  <title>{{ site.title | xml_escape }} — 台灣開源 AI 基礎模型技術紀錄</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url | xml_escape }}" rel="alternate" type="text/html"/>
  <id>{{ '/' | absolute_url | xml_escape }}</id>
  <updated>{{ site.posts.first.last_modified_at | default: site.posts.first.date | default: site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <uri>{{ site.author.url | xml_escape }}</uri>
  </author>
  {% for post in site.posts limit: 20 %}
  <entry>
    <title>{% if post.zh_title %}{{ post.zh_title | xml_escape }} ({{ post.title | xml_escape }}){% else %}{{ post.title | xml_escape }}{% endif %}</title>
    <link href="{{ post.url | absolute_url | xml_escape }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <author>
      <name>{{ post.author | default: site.author.name | xml_escape }}</name>
      <uri>{{ site.author.url | xml_escape }}</uri>
    </author>
    {% if post.category %}<category term="{{ post.category | xml_escape }}"/>{% endif %}
    {% for tag in post.tags %}<category term="{{ tag | xml_escape }}"/>{% endfor %}
    <summary>{{ post.zh_description | default: post.description | default: site.description | xml_escape }}</summary>
    <content type="text">{{ post.content | strip_html | normalize_whitespace | truncate: 6000 | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
